{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mudaar-bot",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  "keep_vars": true,
  "observability": { "enabled": true },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": {
    "bindings": [{ "name": "LEDGER", "class_name": "Ledger" }, { "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Ledger"] }, { "tag": "v2", "new_sqlite_classes": ["Hub"] }],
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "TIMEZONE_OFFSET_MINUTES": "180",
    "GRAPH_VERSION": "v23.0",
    "PUBLIC_HOSTS": "mudaar-hs.com,www.mudaar-hs.com",
    "APP_HOST": "app.mudaar-hs.com"
  }
}
